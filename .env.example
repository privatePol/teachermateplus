DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Manila
SITE_URL=http://127.0.0.1:8000

# Database (SQLite default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# SMTP / Email (example: Google Workspace / Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@ncba.edu.ph
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=noreply@ncba.edu.ph
EMAIL_TIMEOUT=10
SIS_API_TOKEN=replace-with-strong-random-token

# Security flags
PRIVACY_CONSENT_VERSION=2026-03
ENFORCE_SINGLE_DEVICE_SESSION=True
DJANGO_SESSION_TIMEOUT_SECONDS=3600
DJANGO_SESSION_SAVE_EVERY_REQUEST=True
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=False
