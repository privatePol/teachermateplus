DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave blank for direct/local access. In deployment, list only the IPs or CIDRs
# of reverse proxies allowed to supply X-Forwarded-For / X-Real-IP.
DJANGO_TRUSTED_PROXY_IPS=
# Enable only when Gunicorn is reachable exclusively through an access-controlled
# Unix socket and only the trusted reverse proxy can supply forwarding headers.
DJANGO_TRUST_UNIX_SOCKET_PROXY=False
DJANGO_TIME_ZONE=Asia/Manila
SITE_URL=http://127.0.0.1:8000
SIGNATURE_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key

# Database (SQLite default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# SMTP / Email (example: Google Workspace / Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@ncba.edu.ph
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=noreply@ncba.edu.ph
EMAIL_TIMEOUT=10
# Keep disabled in development, staging, testing, and UAT. Production administrators
# can request invitation delivery per import only when this system switch is enabled.
FACULTY_IMPORT_EMAIL_ENABLED=False
FACULTY_INVITATION_EXPIRY_HOURS=24

# SIS API integration
# Prefer tenant-bound API keys created with:
# python manage.py create_sis_api_key --tenant-code NCBA --name "NCBA SIS"
# SIS_API_TOKEN remains available for legacy deployments only.
SIS_API_TOKEN=replace-with-strong-random-token
SIS_API_LEGACY_TOKEN_ENABLED=True
SIS_API_RATE_LIMIT_PER_MINUTE=60

# Anonymous Exit Pulse submission protection. These limits are per minute.
# LocMemCache enforces them per Gunicorn worker only; use an approved shared
# Django cache backend when deployment requires cross-worker throttling.
# Database uniqueness and lifecycle checks remain the correctness controls.
# Shared campus IPs are not used as the one-response identity control.
EXIT_PULSE_BROWSER_RATE_LIMIT_PER_MINUTE=6
EXIT_PULSE_IP_RATE_LIMIT_PER_MINUTE=120

# Cache / dev diagnostics
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=teachermateplus-local
DJANGO_DEBUG_TOOLBAR=False
DJANGO_INTERNAL_IPS=127.0.0.1

# Security flags
PRIVACY_CONSENT_VERSION=2026-03
ENFORCE_SINGLE_DEVICE_SESSION=True
DJANGO_SESSION_TIMEOUT_SECONDS=3600
DJANGO_SESSION_SAVE_EVERY_REQUEST=True
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
MAINTENANCE_MODE=False
ACTUAL_DATA_RESET_ALLOW_PRODUCTION=False
ACTUAL_DATA_RESET_EXTERNAL_BACKUP_CONFIRMED=False
DJANGO_LOG_DIR=logs
