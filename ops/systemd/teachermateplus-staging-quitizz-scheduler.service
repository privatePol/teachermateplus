[Unit]
Description=TeacherMate+ Staging QuiTizz Automatic Game Show Scheduler
After=network.target

[Service]
Type=simple
User=teachermateplus_staging
Group=teachermateplus_staging
WorkingDirectory=/opt/teachermateplus_staging
EnvironmentFile=/etc/teachermateplus_staging/teachermateplus_staging.env
Environment=QUITIZZ_DEPLOYMENT=staging
ExecStart=/opt/teachermateplus_staging/.venv/bin/python manage.py run_quitizz_scheduler
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
