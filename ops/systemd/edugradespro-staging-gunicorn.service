[Unit]
Description=EduGradesPro Staging Gunicorn Service
After=network.target

[Service]
Type=simple
User=edugradespro-staging
Group=edugradespro-staging
WorkingDirectory=/opt/edugradespro-staging
EnvironmentFile=/etc/edugradespro-staging/edugradespro.env
ExecStart=/opt/edugradespro-staging/.venv/bin/gunicorn config.wsgi:application --workers 2 --timeout 120 --bind unix:/run/edugradespro-staging/gunicorn.sock --access-logfile - --error-logfile -
RuntimeDirectory=edugradespro-staging
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
