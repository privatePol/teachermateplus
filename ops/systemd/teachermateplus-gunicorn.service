[Unit]
Description=teachermateplus Gunicorn Service
After=network.target

[Service]
Type=simple
User=teachermateplus
Group=teachermateplus
WorkingDirectory=/opt/teachermateplus
EnvironmentFile=/etc/teachermateplus/teachermateplus.env
ExecStart=/opt/teachermateplus/.venv/bin/gunicorn config.wsgi:application --workers 3 --timeout 120 --bind unix:/run/teachermateplus/gunicorn.sock --access-logfile - --error-logfile -
RuntimeDirectory=teachermateplus
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
