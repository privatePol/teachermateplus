[Unit]
Description=teachermateplus Staging Gunicorn Service
After=network.target

[Service]
Type=simple
User=teachermateplus-staging
Group=teachermateplus-staging
WorkingDirectory=/opt/teachermateplus-staging
EnvironmentFile=/etc/teachermateplus-staging/teachermateplus.env
ExecStart=/opt/teachermateplus-staging/.venv/bin/gunicorn config.wsgi:application --workers 2 --timeout 120 --bind unix:/run/teachermateplus-staging/gunicorn.sock --access-logfile - --error-logfile -
RuntimeDirectory=teachermateplus-staging
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
