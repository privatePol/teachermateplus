[Unit]
Description=teachermateplus Staging Gunicorn Service
After=network.target

[Service]
Type=simple
User=teachermateplus_staging
Group=teachermateplus_staging
WorkingDirectory=/opt/teachermateplus_staging
EnvironmentFile=/etc/teachermateplus_staging/teachermateplus_staging.env
Environment=QUITIZZ_DEPLOYMENT=staging
ExecStart=/opt/teachermateplus_staging/.venv/bin/gunicorn config.wsgi:application --workers 2 --timeout 120 --bind unix:/run/teachermateplus-staging/gunicorn.sock --access-logfile - --error-logfile -
RuntimeDirectory=teachermateplus-staging
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
