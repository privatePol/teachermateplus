[Unit]
Description=teachermateplus QuiTizz ASGI Service
After=network.target

[Service]
Type=simple
User=teachermateplus
Group=teachermateplus
WorkingDirectory=/opt/teachermateplus
EnvironmentFile=/etc/teachermateplus/teachermateplus.env
Environment=QUITIZZ_DEPLOYMENT=production
ExecStart=/opt/teachermateplus/.venv/bin/daphne --proxy-headers -b 127.0.0.1 -p 8001 --websocket_timeout 28800 --ping-interval 30 --ping-timeout 30 config.asgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
