[Unit]
Description=edugradeplus Gunicorn Service
After=network.target

[Service]
Type=simple
User=edugradeplus
Group=edugradeplus
WorkingDirectory=/opt/edugradeplus
EnvironmentFile=/etc/edugradeplus/edugradeplus.env
ExecStart=/opt/edugradeplus/.venv/bin/gunicorn config.wsgi:application --workers 3 --timeout 120 --bind unix:/run/edugradeplus/gunicorn.sock --access-logfile - --error-logfile -
RuntimeDirectory=edugradeplus
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
